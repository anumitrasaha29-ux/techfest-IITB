            }
            lines {
              text: "    // Bottom Plate"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const bottomPlate = new THREE.Mesh(new THREE.CylinderGeometry(2.1, 1.9, 0.25, 6), armorMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    bottomPlate.position.set(0, -1.2, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
