            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Subsystem 4: Peripheral Armor Shell Brackets (Front & Rear Shells)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const armorGroup = new THREE.Group();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const armorMat = createPBRMaterial();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
