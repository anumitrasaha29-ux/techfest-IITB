              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Top Plate"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const topPlate = new THREE.Mesh(new THREE.CylinderGeometry(1.9, 2.1, 0.25, 6), armorMat);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    topPlate.position.set(0, 1.2, 0);"
